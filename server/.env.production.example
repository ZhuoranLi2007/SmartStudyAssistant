# Copy to server/.env.production and provide all secrets through environment variables.
SMARTSTUDY_ENVIRONMENT=production
SMARTSTUDY_AI_MOCK_FALLBACK=false
SMARTSTUDY_LOG_LEVEL=INFO
SMARTSTUDY_JWT_SECRET=replace-with-a-long-random-secret
SMARTSTUDY_DATABASE_URL=mysql+asyncmy://smartstudy:replace-password@127.0.0.1:3306/smartstudy?charset=utf8mb4
